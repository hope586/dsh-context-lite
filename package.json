{
  "name": "dsh-context-lite",
  "version": "0.3.0",
  "type": "module",
  "private": true,
  "description": "Read-only context timeline and provenance sidebar for DeepSeek Harness",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./schemas/developer-audit.schema.json": "./schemas/developer-audit.schema.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "licenses",
    "docs/compatibility.md",
    "docs/provenance.md",
    "docs/developer-audit.md",
    "schemas",
    "CHANGELOG.md"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node --check src/index.js && node --check src/audit.js && node --check src/developer-audit.js && node --check src/provenance.js && node --check src/collector.js && node --check src/origin-store.js && node --check src/client.js && node --check src/i18n.js",
    "verify:package": "node scripts/check-package.mjs",
    "verify:public": "node scripts/check-public.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-scope": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-token-meter": "0.2.0-rc.2",
    "esbuild": "0.25.12",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-scope": ">=0.2.0-rc.2 <0.3.0"
  },
  "author": "hope586",
  "packageManager": "pnpm@10.33.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hope586/dsh-context-lite.git"
  },
  "homepage": "https://github.com/hope586/dsh-context-lite#readme",
  "bugs": {
    "url": "https://github.com/hope586/dsh-context-lite/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "context",
    "timeline",
    "provenance",
    "observability"
  ]
}
